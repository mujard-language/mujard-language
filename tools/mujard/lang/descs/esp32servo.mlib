        "detach": {"params": [], "result": "void"},
        "write": {"params": [{"name": "value", "type": "int"}], "result": "void"},
        "writeMicroseconds": {"params": [{"name": "value", "type": "int"}], "result": "void"},
        "writeTicks": {"params": [{"name": "value", "type": "int"}], "result": "void"},
        "read": {"params": [], "result": "int"},
        "readMicroseconds": {"params": [], "result": "int"},
        "readTicks": {"params": [], "result": "int"},
        "attached": {"params": [], "result": "bool"},
        "setPeriodHertz": {"params": [{"name": "hertz", "type": "int"}], "result": "void"},
        "setTimerWidth": {"params": [{"name": "bits", "type": "int"}], "result": "void"}
      }
    }
  },
