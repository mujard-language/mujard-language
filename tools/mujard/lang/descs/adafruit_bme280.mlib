        "setSampling": {"params": [{"name": "mode", "type": "int", "optional": true}, {"name": "tempSampling", "type": "int", "optional": true}, {"name": "pressSampling", "type": "int", "optional": true}, {"name": "humSampling", "type": "int", "optional": true}, {"name": "filter", "type": "int", "optional": true}, {"name": "duration", "type": "int", "optional": true}], "result": "void"},
        "setTemperatureCompensation": {"params": [{"name": "adjustment", "type": "float"}], "result": "void"},
