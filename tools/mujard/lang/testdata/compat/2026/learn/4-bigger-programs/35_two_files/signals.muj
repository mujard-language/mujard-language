# signals.muj - a module: no board line needed, and its own events and tasks don't run in the program that imports it.

const COUNT = 3

fn next(mode: int) -> int:
    return (mode + 1) mod COUNT

fn name(mode: int) -> text:
    match mode:
        0:
            return "slow"
        1:
            return "medium"
        else:
            return "fast"

fn rate(mode: int) -> frequency:
    match mode:
        0:
            return 1 Hz
        1:
            return 3 Hz
        else:
            return 8 Hz
