# sample: a running light on a 74HC595 shift register
board uno
use mujard.shift

leds = shift.out_register(data: pin 11, clock: pin 12, latch: pin 8)
var pattern = 0b0000_0001

every 100 ms:
    leds.write(pattern)
    pattern = pattern << 1
    if pattern > 0b1000_0000:
        pattern = 0b0000_0001

test "the light runs along the register":
    advance(250 ms)
    expect pattern > 1, "the bit marches along"
    advance(800 ms)
    expect pattern <= 128, "it wraps back around"
