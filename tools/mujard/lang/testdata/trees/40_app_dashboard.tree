(file uno
  (device pump pin [7] output [] to_end=false)
  (device soil analog [A0]  [] to_end=false)
  (var watering_ml = 200)
  (var auto = true)
  (control "Water per run (ml)" watering_ml (.. 50 500))
  (control "Automatic" auto _)
  (every 10s
    (var moisture = soil.percent)
    (do (call show (text "Soil") moisture as:(call gauge (.. 0% 100%))))
    (do (call show (text "Pump") (call pump.read)))
    (do (call plot moisture))
    (if (< moisture 20%)
      (do (call notify (text "The soil is dry (" {moisture} ")") urgent:true))
    )
  )
  (task water
    (while true
      (wait-until (< soil.percent 20%))
      (var go = auto)
      (if (not auto)
        (var answer = (call ask (text "Water the plant now?")))
        (if (!= answer none)
          (= go answer)
        )
      )
      (if go
        (do (call pump.on))
        (wait (* watering_ml 50ms))
        (do (call pump.off))
        (print (text "Watered " {watering_ml} " ml"))
      )
      (wait 10min)
    )
  )
  (test "dry soil waters and reports"
    (do (call soil.pretend 10%))
    (do (call advance 200ms))
    (expect (call notified (text "The soil is dry")) (text "the dry alert fires"))
    (do (call advance 20s))
    (expect (call printed (text "Watered")) (text "the pump ran and reported"))
  )
)
