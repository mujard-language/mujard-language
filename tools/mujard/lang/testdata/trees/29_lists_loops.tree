(file uno
  (device sensor analog [A0]  [] to_end=false)
  (var readings:list[int,10] = [])
  (every 100ms
    (if (== readings.length 10)
      (do (call readings.remove 0))
    )
    (do (call readings.add sensor.value))
  )
  (every 1s
    (var total = 0)
    (var highest = 0)
    (for r in readings
      (if (== r 0)
        (continue)
      )
      (+= total r)
      (= highest (call max highest r))
    )
    (var i = 0)
    (while (< i readings.length)
      (if (> readings[i] 1000)
        (print (text "Very bright at sample " {i}))
        (break)
      )
      (+= i 1)
    )
    (if (> readings.length 0)
      (print (text "Average " {(/ total readings.length)} ", highest " {highest}))
    )
  )
  (test "readings collect and report"
    (do (call sensor.pretend 500))
    (do (call advance 1500ms))
    (expect (> readings.length 0) (text "samples accumulate"))
    (expect (call printed (text "Average")) (text "the stats print"))
  )
)
