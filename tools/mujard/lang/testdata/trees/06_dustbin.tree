(file uno
  (use mujard "mujard.servo" version="" as="")
  (use mujard "mujard.ultrasonic" version="" as="")
  (device lid (call Servo (pin 6)))
  (device hand (call Ultrasonic trig:(pin 9) echo:(pin 10)))
  (const NEAR = 20cm)
  (var open = false)
  (var last_seen = (call now))
  (at start
    (do (call lid.move 0deg))
  )
  (every 100ms
    (var d = (call hand.distance))
    (if (and (!= d none) (< d NEAR))
      (= last_seen (call now))
      (if (not open)
        (do (call lid.move 90deg over:400ms))
        (= open true)
      )
    )
    (elif (and open (> (call since last_seen) 3s))
      (do (call lid.move 0deg over:600ms))
      (= open false)
    )
  )
  (test "opens on a near hand and closes after"
    (do (call hand.pretend 10cm))
    (do (call advance 200ms))
    (expect open (text "a near hand opens the lid"))
    (do (call hand.pretend 80cm))
    (do (call advance 4s))
    (expect (not open) (text "the lid closes after the wait"))
  )
)
