# Project: a joystick module over Bluetooth
# Level 5 - Advanced
#
# The app shows the stick's position as two gauges, and the app's own joystick drives an LED on GPIO4
# (an LED + resistor; the onboard LED is often on GPIO2 but that pin warns as a boot pin). Stick X/Y go to
# GPIO34/GPIO35 (ADC1 - ADC2 pins can't be read while the radio is on). Let go - or lose the link - and the LED rests.
board esp32
use mujard.ble

joy_x = analog 34
joy_y = analog 35
led = pin 4 as pwm

var drive = 0 %
var steer = 0 %
var flash = false
control "LED", drive, steer, -100 %..100 %
control "Flash", flash, hold

at start:
    ble.start("mujard-joy")

every 20 ms:
    led.write(clamp(drive, 0 %..100 %))
    if flash:
        led.write(100 %)

every 200 ms:
    show "Stick X", joy_x.percent
    show "Stick Y", joy_y.percent

every 2 s:
    if joy_x.percent > 95 % or joy_y.percent > 95 %:
        notify "Stick pushed to the edge!"
