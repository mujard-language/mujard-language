# sample: an Arduino library and a cpp block
board uno
use "Adafruit NeoPixel" version "1.12.3"

strip = Adafruit_NeoPixel(8, pin 6, NEO_GRB + NEO_KHZ800)
var hue = 0

at start:
    strip.begin()

every 20 ms:
    hue = (hue + 256) mod 65536
    strip.fill(strip.ColorHSV(hue))
    strip.show()

cpp:
    // plain C++ for anything Mujard can't say yet
    static_assert(sizeof(int) >= 2, "int too small");


test "the strip updates":
    advance(100 ms)
