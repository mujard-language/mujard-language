# module: a helper file for 32_two_files.muj - 'import motors' brings these names in as motors.<name>
board uno

const top_speed = 800
var armed = true

fn reset():
    armed = false

fn faster(v: int) -> int:
    if v in 0..top_speed:
        return v + 100
    return top_speed

fn ready() -> bool:
    return armed
